#!/bin/sh
# Pre-commit hook: blocks commits that contain secrets or tracked .env files.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "🔐 Running secret scan pre-commit hook..."

# 1. Check that no .env file (except .env.example) is staged
staged_env=$(git diff --cached --name-only | grep -E '\.env$|\.env\.' | grep -v '\.env\.example' || true)
if [ -n "$staged_env" ]; then
  echo ""
  echo "❌ COMMIT BLOCKED: You are attempting to commit an .env file:"
  echo "   $staged_env"
  echo ""
  echo "   Real credentials must never be committed. Use GitHub Actions secrets"
  echo "   for CI and keep .env files out of version control."
  echo ""
  exit 1
fi

# 2. Run Python secret scanner over staged files
staged_files=$(git diff --cached --name-only || true)
if [ -n "$staged_files" ]; then
  python3 scripts/audit_secrets.py 2>&1
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ COMMIT BLOCKED: Potential secrets detected in staged files."
    echo "   Review the output above, remove any credentials, and re-stage."
    echo ""
    exit 1
  fi
fi

echo "✅ Secret scan passed. Proceeding with commit."
exit 0
